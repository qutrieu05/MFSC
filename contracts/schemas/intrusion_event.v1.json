{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "msfc/intrusion_event.v1",
  "title": "Danger zone enter/exit event",
  "x-status": "active",
  "type": "object",
  "required": [
    "zone_id",
    "event",
    "persons"
  ],
  "properties": {
    "zone_id": {
      "type": "string"
    },
    "event": {
      "enum": [
        "ENTER",
        "EXIT"
      ]
    },
    "persons": {
      "type": "integer",
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "detection_latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "snapshot_ref": {
      "type": "string",
      "description": "Anonymized snapshot only (NFR-PRV-01)."
    }
  },
  "additionalProperties": false
}

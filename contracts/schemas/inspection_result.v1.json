{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "msfc/inspection_result.v1",
  "title": "Vision inspection result for one product",
  "x-status": "active",
  "type": "object",
  "required": [
    "product_id",
    "verdict",
    "confidence",
    "model",
    "timings_ms"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^[0-9]+-[0-9]+$"
    },
    "verdict": {
      "enum": [
        "GOOD",
        "DEFECT",
        "UNCERTAIN"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "class_scores": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "model": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "age_ms": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "timings_ms": {
      "type": "object",
      "required": [
        "total"
      ],
      "properties": {
        "frame_select": {
          "type": "number",
          "minimum": 0
        },
        "preprocess": {
          "type": "number",
          "minimum": 0
        },
        "inference": {
          "type": "number",
          "minimum": 0
        },
        "postprocess": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "image_ref": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
